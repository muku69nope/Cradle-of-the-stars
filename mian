    function searchBySingleTag(tag) {
      selectedSearchTags.clear();
      selectedSearchTags.add(tag);
      switchView("search");
      document.getElementById("globalSearchInput").value = "";
      renderSearchPageTags();
      executeSearch();
    }

    function executeSearch() {
      const query = (document.getElementById("globalSearchInput").value || "").trim().toLowerCase();
      const requiredTags = Array.from(selectedSearchTags);
      const results = [];

      const matchesTags = (tags = []) => {
        if (requiredTags.length === 0) return true;
        return requiredTags.every(rt => tags.includes(rt));
      };

      const highlight = (text, q) => {
        if (!q) return escapeHTML(text);
        const safeText = escapeHTML(text);
        const regex = new RegExp(`(${q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, "gi");
        return safeText.replace(regex, "<mark>$1</mark>");
      };

      const escapeHTML = (str) => {
        return (str || "").replace(/[&<>'"]/g, 
          tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
        );
      };

      // 1. キャラクター検索
      appData.characters.forEach(c => {
        if (!matchesTags(c.tags)) return;

        let matchedSnippets = [];
        let score = 0;

        const checkMatch = (field, label) => {
          if (!field) return;
          if (field.toLowerCase().includes(query)) {
            score++;
            matchedSnippets.push(`<strong>[${label}]</strong> ${field}`);
          }
        };

        if (query) {
          checkMatch(c.name, "名前");
          checkMatch(c.nameEn, "英名");
          checkMatch(c.quote, "セリフ/名言");
          (c.specs || []).forEach(s => checkMatch(`${s.key}: ${s.val}`, "基本データ"));
          (c.freeSections || []).forEach(sec => checkMatch(`${sec.title}: ${sec.body}`, "自由設定項目"));
          (c.dialogues || []).forEach(d => checkMatch(d, "セリフ集"));
          (c.relations || []).forEach(r => checkMatch(`${r.target} (${r.tag}): ${r.note}`, "相関"));
        } else {
          // クエリなし、タグ一致のみ
          score = 1;
          const bio = c.freeSections?.[0]?.body || "";
          matchedSnippets.push(bio.slice(0, 120) + (bio.length > 120 ? "..." : ""));
        }

        if (score > 0) {
          results.push({
            type: "CHARACTER",
            title: `${c.name} (${c.nameEn || ''})`,
            id: c.id,
            tags: c.tags,
            snippets: matchedSnippets.slice(0, 3)
          });
        }
      });

      // 2. 世界観 用語集
      appData.worldTerms.forEach(w => {
        if (!matchesTags(w.tags)) return;
        let matched = false;
        let snippet = w.desc;
        if (query) {
          if (w.title.toLowerCase().includes(query) || w.desc.toLowerCase().includes(query)) {
            matched = true;
          }
        } else {
          matched = true;
        }

        if (matched) {
          results.push({
            type: "WORLD / 用語",
            title: w.title,
            tags: w.tags,
            snippets: [snippet]
          });
        }
      });

      // 3. 作品集
      appData.works.forEach(w => {
        if (!matchesTags(w.tags)) return;
        let matched = false;
        if (query) {
          if (w.title.toLowerCase().includes(query) || w.desc.toLowerCase().includes(query) || w.type.toLowerCase().includes(query)) {
            matched = true;
          }
        } else {
          matched = true;
        }

        if (matched) {
          results.push({
            type: `WORK / ${w.type}`,
            title: w.title,
            tags: w.tags,
            snippets: [w.desc]
          });
        }
      });

      // 4. カスタムページ
      (appData.customPages || []).forEach(p => {
        if (!matchesTags(p.tags)) return;
        let snippets = [];
        let matched = false;

        if (query) {
          if (p.title.toLowerCase().includes(query)) { matched = true; snippets.push(p.desc); }
          if (p.desc.toLowerCase().includes(query)) { matched = true; snippets.push(p.desc); }
          (p.sections || []).forEach(sec => {
            if (sec.heading.toLowerCase().includes(query) || sec.body.toLowerCase().includes(query)) {
              matched = true;
              snippets.push(`<strong>[${sec.heading}]</strong> ${sec.body}`);
            }
          });
        } else {
          matched = true;
          snippets.push(p.desc);
        }

        if (matched) {
          results.push({
            type: "CUSTOM PAGE",
            title: p.title,
            id: p.id,
            tags: p.tags,
            snippets: snippets.slice(0, 2)
          });
        }
      });

      // レンダリング
      const resultContainer = document.getElementById("searchResultsList");
      document.getElementById("searchResultCount").textContent = `${results.length} MATCHES`;

      if (results.length === 0) {
        resultContainer.innerHTML = '<div style="padding:2rem; text-align:center; color:var(--text-dim); border:1px solid var(--border); border-radius:var(--radius);">一致する項目が見つかりませんでした。</div>';
        return;
      }

      resultContainer.innerHTML = results.map(res => `
        <div class="search-result-item" onclick="handleSearchResultClick('${res.type}', '${res.id || ''}')">
          <div class="search-res-type">[ ${res.type} ]</div>
          <div class="search-res-title">${res.title}</div>
          <div class="tag-container" style="margin-bottom:0.5rem;">
            ${(res.tags || []).map(t => `<span class="tag-pill" style="font-size:0.68rem; padding:0.1rem 0.4rem;">${t}</span>`).join("")}
          </div>
          <div class="search-res-snippet">
            ${res.snippets.map(s => `<div>${highlight(s, query)}</div>`).join("")}
          </div>
        </div>
      `).join("");
    }

    function handleSearchResultClick(type, id) {
      if (type === "CHARACTER") {
        openDossier(id);
      } else if (type === "CUSTOM PAGE") {
        openCustomPage(id);
      } else if (type.startsWith("WORLD")) {
        switchView("world");
      } else if (type.startsWith("WORK")) {
        switchView("works");
      }
    }

    // --- BACKUP & RESTORE ---
    function exportJSON() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appData, null, 2));
      const a = document.createElement("a");
      a.href = dataStr;
      a.download = "character_archive_backup.json";
      a.click();
    }
    function importJSON(event) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (e) => {
          try {
            appData = JSON.parse(e.target.result);
            if (!appData.adminPass) appData.adminPass = "admin";
            if (!appData.customPages) appData.customPages = [];
            // マイグレーション
            appData.characters.forEach(c => {
              if (!c.freeSections) {
                c.freeSections = [];
                if (c.bio) c.freeSections.push({ title: "BACKGROUND / 経歴・生い立ち", body: c.bio });
              }
              if (!c.tags) c.tags = [];
            });
            saveData();
            initApp();
            alert("データを復元しました！");
          } catch(err) {
            alert("ファイルの読み込みに失敗しました。正しいJSONファイルかご確認ください。");
          }
        };
        reader.readAsText(file);
      }
    }

    window.addEventListener("scroll", () => {
      const btn = document.getElementById("scrollTopBtn");
      if (window.scrollY > 300) btn.classList.add("visible");
      else btn.classList.remove("visible");
    });

    function initApp() {
      document.getElementById("siteTitle").innerText = appData.siteTitle || "PROJECT ARCHIVE";
      document.getElementById("homeHeroTitle").innerText = appData.homeHeroTitle;
      document.getElementById("homeHeroSub").innerText = appData.homeHeroSub;
      document.getElementById("worldTitle").innerText = appData.worldTitle;
      document.getElementById("worldOverview").innerText = appData.worldOverview;
      applyStyles();
      renderNavTabs();
      renderMicroCards();
      renderCurrentDossier();
      renderWorldAndWorks();
      attachInlineEditListeners();
    }

    window.addEventListener("DOMContentLoaded", initApp);
  </script>
</body>
</html>
