    function renderRadar(chara) {
      const stats = chara.stats || [];
      const n = stats.length;
      const svg = document.getElementById("radarSvg");
      const statList = document.getElementById("statListContainer");

      if (n < 3) {
        svg.innerHTML = '<text x="150" y="150" text-anchor="middle" fill="#6b7280" font-size="12">3項目以上必要です</text>';
        statList.innerHTML = '';
        return;
      }

      const cx = 150, cy = 150, r = 100;
      let gridSvg = "";

      [0.25, 0.5, 0.75, 1.0].forEach(level => {
        let pts = [];
        for (let i = 0; i < n; i++) {
          const angle = (Math.PI * 2 / n) * i - Math.PI / 2;
          const x = cx + r * level * Math.cos(angle);
          const y = cy + r * level * Math.sin(angle);
          pts.push(`${x},${y}`);
        }
        gridSvg += `<polygon points="${pts.join(" ")}" fill="none" stroke="#e5e7eb" stroke-width="1"/>`;
      });

      let dataPts = [];
      for (let i = 0; i < n; i++) {
        const angle = (Math.PI * 2 / n) * i - Math.PI / 2;
        const x = cx + r * Math.cos(angle);
        const y = cy + r * Math.sin(angle);
        gridSvg += `<line x1="${cx}" y1="${cy}" x2="${x}" y2="${y}" stroke="#e5e7eb" stroke-width="1"/>`;

        const valRatio = Math.max(0, Math.min(100, stats[i].val)) / 100;
        const vx = cx + r * valRatio * Math.cos(angle);
        const vy = cy + r * valRatio * Math.sin(angle);
        dataPts.push(`${vx},${vy}`);

        const lx = cx + (r + 18) * Math.cos(angle);
        const ly = cy + (r + 18) * Math.sin(angle);
        gridSvg += `<text x="${lx}" y="${ly}" font-size="10" font-weight="600" fill="#4b5563" text-anchor="middle" dominant-baseline="middle">${stats[i].label}</text>`;
      }

      const fillSvg = `<polygon points="${dataPts.join(" ")}" fill="${chara.theme || 'var(--accent)'}" fill-opacity="0.3" stroke="${chara.theme || 'var(--accent)'}" stroke-width="2"/>`;
      svg.innerHTML = gridSvg + fillSvg;

      statList.innerHTML = stats.map((s, idx) => `
        <div class="stat-row">
          <span class="stat-label" contenteditable="${isEditMode}" onblur="updateStatLabel(${idx}, this.innerText)">${s.label}</span>
          <div class="stat-bar-bg preview-only">
            <div class="stat-bar-fill" style="width:${s.val}%"></div>
