<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PROJECT ARCHIVE // 一次創作設定資料録</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=JetBrains+Mono:wght@400;600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #09090b;
      --bg-card: #121215;
      --bg-card-sub: #18181b;
      --border: #27272a;
      --border-focus: #3f3f46;
      --text: #f4f4f5;
      --text-muted: #a1a1aa;
      --text-dim: #71717a;
      --accent: #00f0ff;
      --accent-rgb: 0, 240, 255;
      --char-theme: #00f0ff;
      --danger: #ef4444;
      --font-base: 'Zen Kaku Gothic New', sans-serif;
      --font-en: 'Inter', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --radius: 3px;
    }

    body[data-theme="light"] {
      --bg: #f8fafc;
      --bg-card: #ffffff;
      --bg-card-sub: #f1f5f9;
      --border: #e2e8f0;
      --border-focus: #cbd5e1;
      --text: #0f172a;
      --text-muted: #475569;
      --text-dim: #94a3b8;
    }
    body[data-theme="slate"] {
      --bg: #0b1120;
      --bg-card: #0f172a;
      --bg-card-sub: #1e293b;
      --border: #334155;
      --border-focus: #475569;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
    }
    body[data-theme="sepia"] {
      --bg: #1c1815;
      --bg-card: #26211c;
      --bg-card-sub: #332d27;
      --border: #473e35;
      --border-focus: #5c5044;
      --text: #eeddc9;
      --text-muted: #c4af98;
      --text-dim: #94816d;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-base);
      line-height: 1.6;
      font-size: 14px;
      overflow-x: hidden;
      transition: background-color 0.25s, color 0.25s;
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
    }

    .mono { font-family: var(--font-mono); }
    .en { font-family: var(--font-en); }
    .container { max-width: 1240px; margin: 0 auto; padding: 0 1.5rem; }
    button, input, select, textarea { font-family: inherit; font-size: inherit; color: inherit; }
    button { cursor: pointer; border: none; background: none; }

    body:not(.is-edit-mode) .edit-only { display: none !important; }
    body.is-edit-mode .preview-only { display: none !important; }
    body.is-edit-mode [contenteditable="true"] {
      outline: 1px dashed var(--accent);
      outline-offset: 2px;
      cursor: text;
    }
    body.is-edit-mode [contenteditable="true"]:focus {
      outline: 2px solid var(--accent);
      background: rgba(var(--accent-rgb), 0.08);
    }

    header {
      position: sticky;
      top: 0;
      background: rgba(9, 9, 11, 0.92);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
      z-index: 100;
    }
    body[data-theme="light"] header { background: rgba(248, 250, 252, 0.92); }
    body[data-theme="slate"] header { background: rgba(11, 17, 32, 0.92); }
    body[data-theme="sepia"] header { background: rgba(28, 24, 21, 0.92); }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 1.5rem;
      gap: 1rem;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      flex-shrink: 0;
      cursor: pointer;
    }
    .brand-mark {
      width: 12px;
      height: 12px;
      background: var(--accent);
      box-shadow: 0 0 10px var(--accent);
      transition: background-color 0.2s, box-shadow 0.2s;
    }
    .brand-title {
      font-weight: 700;
      letter-spacing: 0.15em;
      font-size: 1.05rem;
      text-transform: uppercase;
    }

    .nav-tabs-container {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      overflow-x: auto;
      scrollbar-width: none;
      flex: 1;
      margin: 0 0.5rem;
    }
    .nav-tabs-container::-webkit-scrollbar { display: none; }
    .nav-btn {
      padding: 0.4rem 0.85rem;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-muted);
      border-radius: var(--radius);
      border: 1px solid transparent;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .nav-btn:hover { color: var(--text); border-color: var(--border); }
    .nav-btn.active {
      color: #000;
      background: var(--accent);
      border-color: var(--accent);
      font-weight: 700;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-shrink: 0;
    }
    .action-btn {
      padding: 0.4rem 0.75rem;
      font-size: 0.78rem;
      font-weight: 600;
      border: 1px solid var(--border);
      background: var(--bg-card);
      border-radius: var(--radius);
      color: var(--text-muted);
      transition: all 0.2s;
      white-space: nowrap;
    }
    .action-btn:hover { color: var(--text); border-color: var(--text-muted); }
    .action-btn.active-edit {
      background: #ef4444;
      color: #fff;
      border-color: #ef4444;
    }

    #themeDrawer {
      display: none;
      background: var(--bg-card);
      border-bottom: 1px solid var(--border);
      padding: 1rem 1.5rem;
    }
    #themeDrawer.open { display: block; }
    .theme-row {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .theme-opt-group {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .theme-btn {
      padding: 0.25rem 0.65rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      font-size: 0.78rem;
    }
    .color-preset {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 2px solid transparent;
      cursor: pointer;
    }
    .color-preset.selected { border-color: #fff; box-shadow: 0 0 8px rgba(255,255,255,0.4); }

    .view-section { display: none; padding: 2.5rem 0 5rem; }
    .view-section.active { display: block; }

    .home-hero {
      border: 1px solid var(--border);
      background: var(--bg-card);
      padding: 3rem 2rem;
      position: relative;
      margin-bottom: 2.5rem;
    }
    .home-hero::before {
      content: '// ARCHIVE RECORD FILE';
      position: absolute;
      top: 0.75rem;
      right: 1rem;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--text-dim);
    }
    .hero-title {
      font-size: 2.2rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      margin-bottom: 0.8rem;
    }
    .hero-sub {
      color: var(--text-muted);
      max-width: 680px;
      font-size: 0.95rem;
      line-height: 1.8;
    }

    .chara-micro-grid {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 0.75rem;
      margin-bottom: 2rem;
    }
    @media (max-width: 1024px) {
      .chara-micro-grid { grid-template-columns: repeat(6, 1fr); }
    }
    @media (max-width: 768px) {
      .chara-micro-grid { grid-template-columns: repeat(4, 1fr); gap: 0.5rem; }
    }
    .chara-micro-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.5rem;
      text-align: center;
      cursor: pointer;
      position: relative;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .chara-micro-card:hover {
      border-color: var(--char-theme, var(--accent));
      transform: translateY(-3px);
      box-shadow: 0 4px 14px rgba(0,0,0,0.4);
    }
    .micro-avatar {
      width: 100%;
      aspect-ratio: 1 / 1;
      background: var(--bg-card-sub);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      object-fit: cover;
      margin-bottom: 0.4rem;
    }
    .micro-name {
      font-size: 0.78rem;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      width: 100%;
    }
    .micro-role {
      font-size: 0.65rem;
      color: var(--text-dim);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      width: 100%;
    }
    .micro-indicator {
      position: absolute;
      top: 6px;
      right: 6px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--char-theme, var(--accent));
      box-shadow: 0 0 6px var(--char-theme, var(--accent));
    }

    .dossier-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 2rem;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid var(--border);
      flex-wrap: wrap;
      gap: 1rem;
    }
    .dossier-id {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--char-theme, var(--accent));
      letter-spacing: 0.1em;
      margin-bottom: 0.2rem;
    }
    .dossier-name-row {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .dossier-name { font-size: 2.2rem; font-weight: 700; letter-spacing: 0.05em; }
    .dossier-en { font-family: var(--font-en); font-size: 1.1rem; color: var(--text-dim); }
    .dossier-quote {
      font-style: italic;
      color: var(--text-muted);
      margin-top: 0.4rem;
      border-left: 2px solid var(--char-theme, var(--accent));
      padding-left: 0.75rem;
      font-size: 0.92rem;
    }

    .tag-container {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin-top: 0.6rem;
    }
    .tag-pill {
      font-size: 0.72rem;
      padding: 0.2rem 0.55rem;
      background: var(--bg-card-sub);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 0.3rem;
      cursor: pointer;
      transition: all 0.15s;
    }
    .tag-pill:hover {
      border-color: var(--accent);
      color: var(--text);
    }
    .tag-pill.selected {
      background: var(--accent);
      color: #000;
      font-weight: 700;
      border-color: var(--accent);
    }
    .tag-remove { color: var(--danger); font-weight: bold; cursor: pointer; }

    .dossier-body {
      display: grid;
      grid-template-columns: 360px 1fr;
      gap: 2rem;
      margin-bottom: 3rem;
    }
    @media (max-width: 900px) {
      .dossier-body { grid-template-columns: 1fr; }
    }

    .portrait-box {
      border: 1px solid var(--border);
      background: var(--bg-card);
      border-radius: var(--radius);
      overflow: hidden;
      position: relative;
    }
    .portrait-img {
      width: 100%;
      height: 480px;
      object-fit: cover;
      display: block;
      background: var(--bg-card-sub);
    }
    .portrait-upload-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.7);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.2s;
      cursor: pointer;
    }
    .portrait-box:hover .portrait-upload-overlay { opacity: 1; }

    .section-headline {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.15em;
      color: var(--text-dim);
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.35rem;
    }
    .spec-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 1.8rem;
      font-size: 0.88rem;
    }
    .spec-table tr { border-bottom: 1px solid var(--border); }
    .spec-table th {
      text-align: left;
      padding: 0.55rem 0.75rem;
      color: var(--text-muted);
      font-weight: 500;
      background: var(--bg-card);
      width: 28%;
    }
    .spec-table td {
      padding: 0.55rem 0.75rem;
      background: var(--bg-card-sub);
    }
    .spec-table .del-btn { color: var(--danger); float: right; cursor: pointer; }

    /* CUSTOM FREE SECTIONS */
    .free-section-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem 1.25rem;
      margin-bottom: 1.25rem;
      position: relative;
    }
    .free-section-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.5rem;
      border-bottom: 1px dashed var(--border);
      padding-bottom: 0.4rem;
    }
    .free-section-title {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--char-theme, var(--accent));
      letter-spacing: 0.08em;
    }
    .free-section-body {
      color: var(--text-muted);
      line-height: 1.8;
      white-space: pre-wrap;
      font-size: 0.9rem;
    }

    .radar-console {
      background: #ffffff;
      color: #111827;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      margin-bottom: 3rem;
      box-shadow: 0 4px 20px rgba(0,0,0,0.25);
    }
    .radar-grid {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 2rem;
      align-items: center;
    }
    @media (max-width: 768px) {
      .radar-grid { grid-template-columns: 1fr; }
    }
    .radar-svg-wrap {
      width: 100%;
      max-width: 320px;
      margin: 0 auto;
    }
    .stat-list {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .stat-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.82rem;
      font-weight: 600;
    }
    .stat-label { width: 110px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #374151; }
    .stat-bar-bg {
      flex: 1;
      height: 8px;
      background: #e5e7eb;
      border-radius: 4px;
      overflow: hidden;
    }
    .stat-bar-fill {
      height: 100%;
      background: var(--char-theme, var(--accent));
      transition: width 0.3s;
    }
    .stat-val { width: 32px; text-align: right; font-family: var(--font-mono); color: #111827; }
    .stat-slider { width: 90px; }

    .dossier-lower {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin-bottom: 3rem;
    }
    @media (max-width: 820px) {
      .dossier-lower { grid-template-columns: 1fr; }
    }
    .dialogue-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-left: 3px solid var(--char-theme, var(--accent));
      padding: 0.85rem 1rem;
      border-radius: var(--radius);
      margin-bottom: 0.75rem;
      font-size: 0.88rem;
      position: relative;
    }
    .relation-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      padding: 0.85rem 1rem;
      border-radius: var(--radius);
      margin-bottom: 0.75rem;
      position: relative;
    }
    .rel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.35rem;
    }
    .rel-target { font-weight: 700; font-size: 0.95rem; }
    .rel-tag {
      font-size: 0.72rem;
      padding: 0.15rem 0.5rem;
      background: var(--char-theme, var(--accent));
      color: #000;
      font-weight: 700;
      border-radius: 2px;
    }

    .chara-gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1rem;
      margin-top: 1rem;
    }
    .chara-gallery-item {
      border: 1px solid var(--border);
      background: var(--bg-card);
      border-radius: var(--radius);
      overflow: hidden;
      cursor: pointer;
      position: relative;
    }
    .gallery-thumb {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      display: block;
      background: var(--bg-card-sub);
    }
    .gallery-caption {
      padding: 0.5rem;
      font-size: 0.75rem;
      color: var(--text-muted);
      border-top: 1px solid var(--border);
      background: var(--bg-card);
    }

    .works-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.5rem;
    }
    .work-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      cursor: pointer;
      transition: all 0.2s;
    }
    .work-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }
    .work-cover {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      background: var(--bg-card-sub);
    }
    .work-content { padding: 1rem; }
    .work-type-badge {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      padding: 0.2rem 0.5rem;
      background: var(--border);
      color: var(--text-muted);
      border-radius: 2px;
      display: inline-block;
      margin-bottom: 0.4rem;
    }

    /* SEARCH & TAGS PAGE SPECIFIC */
    .search-input-box {
      width: 100%;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.75rem 1rem;
      font-size: 1rem;
      color: var(--text);
      outline: none;
      margin-bottom: 1rem;
      transition: border-color 0.2s;
    }
    .search-input-box:focus { border-color: var(--accent); }
    .search-result-item {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1rem;
      margin-bottom: 0.8rem;
      cursor: pointer;
      transition: all 0.2s;
    }
    .search-result-item:hover {
      border-color: var(--accent);
      transform: translateX(4px);
    }
    .search-res-type {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--accent);
      margin-bottom: 0.25rem;
    }
    .search-res-title {
      font-weight: 700;
      font-size: 1.05rem;
      margin-bottom: 0.35rem;
    }
    .search-res-snippet {
      color: var(--text-muted);
      font-size: 0.85rem;
      line-height: 1.6;
    }
    .search-res-snippet mark {
      background: rgba(var(--accent-rgb), 0.25);
      color: var(--accent);
      padding: 0 2px;
      border-radius: 2px;
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(5px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 1rem;
    }
    .modal-backdrop.open { display: flex; }
    .modal-box {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      width: 100%;
      max-width: 580px;
      max-height: 85vh;
      overflow-y: auto;
      padding: 1.5rem;
      position: relative;
    }
    .lightbox-img {
      max-width: 90vw;
      max-height: 85vh;
      object-fit: contain;
    }

    .anim-fade { animation: transFade 0.4s ease forwards; }
    .anim-slide-up { animation: transSlideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .anim-zoom { animation: transZoom 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .anim-glitch { animation: transGlitch 0.45s ease forwards; }
    .anim-curtain { animation: transCurtain 0.5s ease-out forwards; }
    .anim-melt { animation: transMelt 0.6s ease forwards; }
    .anim-cursed { animation: transCursed 0.6s ease-in-out forwards; }

    @keyframes transFade { from { opacity: 0; } to { opacity: 1; } }
    @keyframes transSlideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes transZoom { from { opacity: 0; transform: scale(1.12); } to { opacity: 1; transform: scale(1); } }
    @keyframes transCurtain {
      0% { clip-path: polygon(0 0, 100% 0, 100% 0, 0 0); }
      100% { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); }
    }
    @keyframes transGlitch {
      0% { opacity: 0; transform: translateX(-8px) skewX(4deg); filter: invert(0.8); }
      25% { transform: translateX(8px) skewX(-4deg); filter: hue-rotate(90deg); }
      50% { transform: translateX(-4px); filter: contrast(2); }
      75% { transform: translateX(4px); }
      100% { opacity: 1; transform: none; filter: none; }
    }
    @keyframes transMelt {
      0% { opacity: 0; filter: blur(12px) contrast(3); transform: scaleY(0.7) translateY(-20px); }
      50% { filter: blur(4px) contrast(2); transform: scaleY(1.05); }
      100% { opacity: 1; filter: none; transform: none; }
    }
    @keyframes transCursed {
