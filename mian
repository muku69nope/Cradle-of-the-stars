    // --- GLOBAL SEARCH & FILTER LOGIC ---
    function renderSearchPageTags() {
      const tagMap = getAllTagsWithUsage();
      const filterBox = document.getElementById("searchFilterTags");
      const tags = Array.from(tagMap.keys()).sort();

      filterBox.innerHTML = tags.map(tag => {
