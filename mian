    function getAllTagsWithUsage() {
      const tagMap = new Map();
      const add = (tag, ref) => {
        if (!tag) return;
        if (!tagMap.has(tag)) tagMap.set(tag, []);
        tagMap.get(tag).push(ref);
      };

      appData.characters.forEach(c => {
        (c.tags || []).forEach(t => add(t, { type: "CHARACTER", name: c.name, id: c.id, ref: c }));
      });
      appData.worldTerms.forEach(w => {
        (w.tags || []).forEach(t => add(t, { type: "WORLD", name: w.title, ref: w }));
      });
      appData.works.forEach(w => {
        (w.tags || []).forEach(t => add(t, { type: "WORK", name: w.title, ref: w }));
      });
      (appData.customPages || []).forEach(p => {
        (p.tags || []).forEach(t => add(t, { type: "PAGE", name: p.title, id: p.id, ref: p }));
      });

      return tagMap;
    }

